rules_version = '2';
// Visitors may add a suggestion and nothing else: no reading, changing or deleting, and only these fields.
service cloud.firestore {
  match /databases/{db}/documents {
    match /suggestions/{id} {
      allow create: if request.resource.data.keys().hasOnly(['bucket', 'text', 'source', 'createdAt'])
        && request.resource.data.bucket in ['idea', 'wrong', 'new-info']
        && request.resource.data.text is string && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 2000
        && request.resource.data.source is string && request.resource.data.source.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
