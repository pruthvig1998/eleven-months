{
  "manifest_version": 3,
  "name": "Eleven Months: rental clause checker",
  "short_name": "Eleven Months",
  "version": "1.2.0",
  "description": "Check an Indian rental agreement clause by clause on your own device. Fixed rules plus Chrome's built-in Gemini Nano.",
  "minimum_chrome_version": "138",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Eleven Months",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self'; frame-src https://eleven-months-nano.web.app"
  }
}
